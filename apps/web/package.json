{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "tsx ../../scripts/build-registry.ts",
    "dev": "next dev --turbopack",
    "prebuild": "tsx ../../scripts/build-registry.ts",
    "build": "next build && pagefind --site out --output-path out/pagefind && rm -rf public/pagefind && cp -r out/pagefind public/pagefind",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@workspace/ui": "*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.16.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pagefind": "^1.5.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^9.39.4",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3"
  }
}
