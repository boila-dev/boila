{
  "name": "boila",
  "version": "0.0.1",
  "description": "Scaffold any boilerplate from the Boila registry with one command.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "boila": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "BOILA_REGISTRY=../../apps/web/public/registry.json BOILA_TEMPLATES_DIR=../../templates tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no linter wired)\" && exit 0",
    "format": "echo \"(no formatter wired)\" && exit 0"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "giget": "^2.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
